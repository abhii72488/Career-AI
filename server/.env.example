PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/career_ai
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# AI Model Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here (optional)
OLLAMA_BASE_URL=http://localhost:11434 (optional)

# RAG & Vector Database (Optional)
EMBEDDING_API_KEY=your_embedding_api_key_here (optional)
VECTOR_DB_URL=your_vector_db_url_here (optional)
VECTOR_DB_API_KEY=your_vector_db_api_key_here (optional)
